<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Encryption -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Privacy -->
	<key>NSFaceIDUsageDescription</key>
	<string>PainDiary verwendet Face ID, um deine Gesundheitsdaten zu schützen.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>PainDiary liest deine Schlafdaten und Schritte aus der Gesundheits-App, um dein Wohlbefinden besser zu verstehen.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>PainDiary schreibt keine Daten in die Gesundheits-App.</string>
	<key>NSCameraUsageDescription</key>
	<string>Wird benötigt, um deinen Körper einmalig für den Körper-Picker zu scannen.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wetterbedingungen zum Zeitpunkt deines Schmerzeintrags erfassen</string>

	<!-- Background Modes — explizit gesetzt damit CloudKit Push korrekt funktioniert -->
	<key>UIBackgroundModes</key>
	<array>
		<string>background-processing</string>
		<string>remote-notification</string>
	</array>

	<!-- Scene -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- Launch screen -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Status bar -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>

	<!-- Orientations iPhone -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Orientations iPad -->
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
